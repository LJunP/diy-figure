# 复制为 .env 后填写真实值。.env 不要提交到仓库。

# ---- 数据库 ----
DB_PASSWORD=qaz123456
DB_NAME=diy_figure
DB_PORT=3306

# ---- 后端 ----
BACKEND_PORT=8080
# 至少 32 字节的随机串,可用 openssl rand -base64 32 生成
JWT_SECRET=
# 前端域名,多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- 管理员初始化(可选,默认关闭)----
# 仅在首次部署需要创建运营账号时开启,创建成功后请置回 false
ADMIN_INIT_ENABLED=false
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=
ADMIN_INIT_EMAIL=

# ---- 外部服务(留空则走降级/模拟分支)----
OPENAI_API_KEY=
MESHY_API_KEY=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=diy-figure

# 前端地址,写进验证邮件/重置邮件链接
DIY_APP_PUBLIC_URL=http://localhost:5173

# 支付回调 HMAC(未配置时回调失败关闭,不会入账)
WECHAT_PAY_API_KEY=
ALIPAY_PAY_API_KEY=
